# Environment
.env
.venv/
# .python-version is deliberately NOT ignored -- it is the only thing pinning
# CI's interpreter. Without it in the repo, a fresh clone gives uv nothing but
# requires-python = ">=3.13", so CI resolves the newest matching Python and
# silently drifts onto a version never run locally.

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store

# IDE / tooling — track Claude Code hooks/permissions, ignore the rest
.claude/*
!.claude/settings.json
.superpowers/
.worktrees/
.idea/
.vscode/
*.swp

# Testing / linting
.pytest_cache/
.ruff_cache/
.ty_cache/

# Streamlit — track theme config, ignore secrets
.streamlit/*
!.streamlit/config.toml
